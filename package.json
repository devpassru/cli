{
  "name": "devpass-cli-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "test": "bun test packages/*/tests",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
